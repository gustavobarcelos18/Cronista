          "title": "Media File Id"
        },
        "media_frame": {
          "title": "Media Frame",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
