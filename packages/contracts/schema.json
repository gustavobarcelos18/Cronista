{
  "$defs": {
    "Beat": {
      "enum": [
        "setup",
        "conflito",
        "falha",
        "virada",
        "conquista"
      ],
      "title": "Beat",
      "type": "string"
    },
    "DecisionIn": {
      "properties": {
        "decision": {
          "enum": [
            "aceito",
            "rejeitado",
            "ajustado"
          ],
          "type": "string"
        },
        "end_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "decision"
      ],
      "title": "DecisionIn",
      "type": "object"
    },
    "EffectKind": {
      "description": "Efeitos que o acabamento pode aplicar, cada um com modo e orçamento próprios.",
      "enum": [
        "zoom",
        "shake",
        "musica",
        "sfx",
        "sfx_meme",
        "piada_visual",
        "contador_mortes",
        "freeze_texto",
        "barra_progresso",
        "legenda_pontual",
        "cartela_dia",
        "cor_lut"
      ],
      "title": "EffectKind",
      "type": "string"
    },
    "EffectMode": {
      "description": "Os três modos da seção 6.4: só marcador, aplicado e editável no Resolve, ou renderizado pelo app.",
      "enum": [
        "sugerir",
        "editavel",
        "renderizado"
      ],
      "title": "EffectMode",
      "type": "string"
    },
    "EffectSettingIn": {
      "properties": {
        "max_per_minute": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "min_score": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "mode": {
          "$ref": "#/$defs/EffectMode"
        }
      },
      "required": [
        "mode",
        "max_per_minute",
        "min_score"
      ],
      "title": "EffectSettingIn",
      "type": "object"
    },
    "EffectSettingOut": {
      "description": "Política de um efeito e de onde ela vem (padrão do app, estilo da série ou ajuste seu no Studio).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EffectKind"
        },
        "max_per_minute": {
          "type": "number"
        },
        "min_score": {
          "type": "number"
        },
        "mode": {
          "$ref": "#/$defs/EffectMode"
        },
        "source": {
          "enum": [
            "padrao",
            "serie",
            "criador"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "mode",
        "max_per_minute",
        "min_score",
        "source"
      ],
      "title": "EffectSettingOut",
      "type": "object"
    },
    "EventOut": {
      "properties": {
        "confidence": {
          "type": "number"
        },
        "end_s": {
          "type": "number"
        },
        "kind": {
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "start_s": {
          "type": "number"
        },
        "variant": {
          "type": "string"
        }
      },
      "required": [
        "stage",
        "variant",
        "kind",
        "start_s",
        "end_s",
        "source",
        "confidence",
        "quote"
      ],
      "title": "EventOut",
      "type": "object"
    },
    "ExportStatus": {
      "description": "Estado da re-exportação de uma sessão; é também o contrato da API (`/sessions/{id}/export`).",
      "properties": {
        "directory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "default": "",
          "type": "string"
        },
        "problems": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reused": {
          "default": false,
          "type": "boolean"
        },
        "state": {
          "default": "idle",
          "enum": [
            "idle",
            "running",
            "done",
            "error"
          ],
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "ExportStatus",
      "type": "object"
    },
    "FeedbackIn": {
      "properties": {
        "seg_start_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "FeedbackIn",
      "type": "object"
    },
    "FeedbackOut": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "interpreted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "interpreted"
      ],
      "title": "FeedbackOut",
      "type": "object"
    },
    "FinishDecisionIn": {
      "properties": {
        "decision": {
          "enum": [
            "aceito",
            "removido",
            "padrao"
          ],
          "type": "string"
        }
      },
      "required": [
        "decision"
      ],
      "title": "FinishDecisionIn",
      "type": "object"
    },
    "FinishItemOut": {
      "description": "Um efeito planejado para um momento do vídeo, com a decisão do criador (se houver).",
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "aceito",
                "removido"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_s": {
          "type": "number"
        },
        "effective_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "intensity": {
          "type": "number"
        },
        "kind": {
          "$ref": "#/$defs/EffectKind"
        },
        "mode": {
          "$ref": "#/$defs/EffectMode"
        },
        "reason": {
          "type": "string"
        },
        "start_s": {
          "type": "number"
        },
        "track": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "mode",
        "track",
        "start_s",
        "duration_s",
        "intensity",
        "reason"
      ],
      "title": "FinishItemOut",
      "type": "object"
    },
    "FinishingOut": {
      "description": "Prévia do acabamento da sessão: políticas por efeito e o que seria aplicado, momento a momento.",
      "properties": {
        "effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EffectSettingOut"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "has_library": {
          "default": false,
          "type": "boolean"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FinishItemOut"
          },
          "type": "array"
        },
        "max_effects_per_minute": {
          "default": 0,
          "type": "number"
        },
        "series": {
          "default": "",
          "type": "string"
        },
        "summary": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "default": {},
          "type": "object"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "FinishingOut",
      "type": "object"
    },
    "JobOut": {
      "properties": {
        "attempts": {
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "integer"
        },
        "media_file_id": {
          "type": "integer"
        },
        "stage": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "media_file_id",
        "stage",
        "variant",
        "status",
        "attempts",
        "error"
      ],
      "title": "JobOut",
      "type": "object"
    },
    "LearningOut": {
      "description": "Proposta de recalibração dos pesos por manter/tirar (7E); `weights` é nulo enquanto faltam decisões.",
      "properties": {
        "applied": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explanation": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "n_decisions": {
          "default": 0,
          "type": "integer"
        },
        "needed": {
          "type": "integer"
        },
        "weights": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "needed"
      ],
      "title": "LearningOut",
      "type": "object"
    },
    "MarkerKind": {
      "enum": [
        "momento",
        "morte_falha",
        "engracado",
        "conquista",
        "novo_dia",
        "construcao",
        "foto_progresso",
        "cinematica"
      ],
      "title": "MarkerKind",
      "type": "string"
    },
    "MarkerOut": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "marker_id": {
          "type": "string"
        },
        "media_file_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_frame": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "marker_id",
        "kind",
        "media_file_id",
        "media_frame",
        "source",
        "warning"
      ],
      "title": "MarkerOut",
      "type": "object"
    },
    "MediaFileOut": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer"
        },
        "size_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "ordinal",
        "size_bytes"
      ],
      "title": "MediaFileOut",
      "type": "object"
    },
    "MediaProbe": {
      "description": "Resultado do `ffprobe` de um arquivo de gravação.",
      "properties": {
        "audio_streams": {
          "default": 0,
          "type": "integer"
        },
        "bit_depth": {
          "default": 8,
          "type": "integer"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fps": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interrupted": {
          "default": false,
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "pix_fmt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "video_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path"
      ],
      "title": "MediaProbe",
      "type": "object"
    },
    "ObjKind": {
      "enum": [
        "principal",
        "secundario",
        "subobjetivo",
        "restricao"
      ],
      "title": "ObjKind",
      "type": "string"
    },
    "ObjState": {
      "enum": [
        "proposto",
        "em_andamento",
        "concluido",
        "falhou",
        "abandonado",
        "suspenso",
        "retomado",
        "incerto"
      ],
      "title": "ObjState",
      "type": "string"
    },
    "PackBeat": {
      "properties": {
        "arquivo_id": {
          "type": "integer"
        },
        "beat": {
          "$ref": "#/$defs/Beat"
        },
        "classe": {
          "enum": [
            "descartavel",
            "dia",
            "momento",
            "farm",
            "conversa",
            "jogo"
          ],
          "type": "string"
        },
        "fala_ao_vivo": {
          "items": {
            "$ref": "#/$defs/PackLiveSpeech"
          },
          "type": "array"
        },
        "fim_s": {
          "type": "number"
        },
        "inicio_s": {
          "type": "number"
        },
        "lacunas": {
          "items": {
            "$ref": "#/$defs/PackWindow"
          },
          "type": "array"
        },
        "marcadores": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "nota": {
          "type": "number"
        },
        "razoes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "segmento_id": {
          "type": "string"
        }
      },
      "required": [
        "segmento_id",
        "arquivo_id",
        "inicio_s",
        "fim_s",
        "beat",
        "classe",
        "nota",
        "razoes",
        "marcadores",
        "fala_ao_vivo",
        "lacunas"
      ],
      "title": "PackBeat",
      "type": "object"
    },
    "PackChapter": {
      "properties": {
        "alocado_s": {
          "type": "number"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/PackBeat"
          },
          "type": "array"
        },
        "n": {
          "type": "integer"
        }
      },
      "required": [
        "n",
        "alocado_s",
        "beats"
      ],
      "title": "PackChapter",
      "type": "object"
    },
    "PackLiveSpeech": {
      "properties": {
        "fim_s": {
          "type": "number"
        },
        "inicio_s": {
          "type": "number"
        },
        "texto": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ausente quando o pacote cortou a transcrição"
        }
      },
      "required": [
        "inicio_s",
        "fim_s"
      ],
      "title": "PackLiveSpeech",
      "type": "object"
    },
    "PackObjective": {
      "properties": {
        "citacao": {
          "type": "string"
        },
        "confirmado": {
          "type": "boolean"
        },
        "estado": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjState"
            },
            {
              "const": "sem_estado",
              "type": "string"
            }
          ]
        },
        "id": {
          "type": "integer"
        },
        "tipo": {
          "$ref": "#/$defs/ObjKind"
        },
        "titulo": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "titulo",
        "tipo",
        "estado",
        "citacao",
        "confirmado"
      ],
      "title": "PackObjective",
      "type": "object"
    },
    "PackProject": {
      "properties": {
        "jogo": {
          "default": "",
          "type": "string"
        },
        "nome": {
          "default": "",
          "type": "string"
        }
      },
      "title": "PackProject",
      "type": "object"
    },
    "PackWindow": {
      "description": "Intervalo em segundos do arquivo de origem.",
      "properties": {
        "fim_s": {
          "type": "number"
        },
        "inicio_s": {
          "type": "number"
        }
      },
      "required": [
        "inicio_s",
        "fim_s"
      ],
      "title": "PackWindow",
      "type": "object"
    },
    "PackagingOut": {
      "properties": {
        "approved_shorts": {
          "default": 0,
          "type": "integer"
        },
        "min_shorts": {
          "default": 3,
          "type": "integer"
        },
        "missing": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ready": {
          "default": false,
          "type": "boolean"
        },
        "shorts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ShortOut"
          },
          "type": "array"
        },
        "thumbnails": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ThumbnailOut"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/TitleOut"
        }
      },
      "required": [
        "title"
      ],
      "title": "PackagingOut",
      "type": "object"
    },
    "ProgressOut": {
      "description": "Jobs da sessão por estado; `active` vale enquanto houver job pendente ou rodando.",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "current": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "done": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        },
        "running": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "total",
        "pending",
        "running",
        "done",
        "failed",
        "active"
      ],
      "title": "ProgressOut",
      "type": "object"
    },
    "ProjectPanelOut": {
      "properties": {
        "capitulos_com_pouco_material": {
          "items": {
            "$ref": "#/$defs/ThinChapterOut"
          },
          "type": "array"
        },
        "por_classe_min": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        "projeto": {
          "type": "string"
        },
        "projeto_id": {
          "type": "integer"
        },
        "sessoes": {
          "items": {
            "$ref": "#/$defs/SeriesRowOut"
          },
          "type": "array"
        },
        "situacao": {
          "enum": [
            "curto_ok",
            "abaixo_da_referencia",
            "no_alvo",
            "acima"
          ],
          "type": "string"
        },
        "total_min": {
          "type": "number"
        }
      },
      "required": [
        "projeto_id",
        "projeto",
        "total_min",
        "situacao",
        "por_classe_min",
        "sessoes",
        "capitulos_com_pouco_material"
      ],
      "title": "ProjectPanelOut",
      "type": "object"
    },
    "PublishOut": {
      "properties": {
        "directory": {
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "directory",
        "files",
        "missing",
        "ready"
      ],
      "title": "PublishOut",
      "type": "object"
    },
    "Script": {
      "properties": {
        "lines": {
          "items": {
            "$ref": "#/$defs/ScriptLine"
          },
          "type": "array"
        },
        "provider": {
          "default": "desconhecido",
          "type": "string"
        },
        "version": {
          "default": 1,
          "type": "integer"
        }
      },
      "title": "Script",
      "type": "object"
    },
    "ScriptLine": {
      "description": "Uma fala sugerida, sempre ligada a um segmento (aceite da Fase 5).",
      "properties": {
        "est_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "justification": {
          "anyOf": [
            {
              "type": "string"
            },
