    "EventOut": {
      "properties": {
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "variant": {
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "variant",
        "kind",
        "start_s",
        "end_s",
        "source",
        "confidence",
        "quote"
      ],
      "title": "EventOut",
      "type": "object"
    },
    "JobOut": {
      "properties": {
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "media_file_id": {
          "title": "Media File Id",
          "type": "integer"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "variant": {
          "title": "Variant",
          "type": "string"
        }
