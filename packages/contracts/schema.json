      "title": "MarkerOut",
      "type": "object"
    },
    "MediaFileOut": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ordinal": {
          "title": "Ordinal",
          "type": "integer"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "ordinal",
        "size_bytes"
      ],
      "title": "MediaFileOut",
      "type": "object"
    },
    "MediaProbe": {
      "description": "Resultado do `ffprobe` de um arquivo de gravação.",
      "properties": {
        "audio_streams": {
          "default": 0,
          "title": "Audio Streams",
          "type": "integer"
        },
        "bit_depth": {
          "default": 8,
          "title": "Bit Depth",
          "type": "integer"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "fps": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "interrupted": {
          "default": false,
          "title": "Interrupted",
          "type": "boolean"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "pix_fmt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pix Fmt"
        },
        "video_codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Codec"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "path"
      ],
      "title": "MediaProbe",
      "type": "object"
    },
    "SegmentOut": {
      "properties": {
        "classe": {
          "title": "Classe",
          "type": "string"
        },
        "end_s": {
          "title": "End S",
          "type": "integer"
        },
        "features": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Features",
          "type": "object"
        },
        "markers": {
          "items": {
            "type": "string"
          },
          "title": "Markers",
          "type": "array"
        },
        "razoes": {
          "items": {
            "type": "string"
          },
          "title": "Razoes",
          "type": "array"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "start_s": {
          "title": "Start S",
          "type": "integer"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "classe",
        "score",
        "razoes",
        "markers",
        "features"
      ],
      "title": "SegmentOut",
      "type": "object"
    },
    "SessionOut": {
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/MediaFileOut"
          },
          "title": "Files",
          "type": "array"
        },
        "folder": {
          "title": "Folder",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "project": {
          "title": "Project",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project",
        "folder",
        "files"
      ],
      "title": "SessionOut",
      "type": "object"
    },
    "StageResult": {
      "description": "Saída de uma etapa do pipeline, persistida como `result.json` no cache.",
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "StageResult",
      "type": "object"
    },
    "WaveformOut": {
      "description": "Envelope de energia (dBFS) por faixa, em até `points` buckets uniformes (máximo de cada bucket).",
      "properties": {
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "game": {
          "items": {
            "type": "number"
          },
          "title": "Game",
          "type": "array"
        },
        "mic": {
          "items": {
            "type": "number"
          },
          "title": "Mic",
          "type": "array"
        },
        "points": {
          "title": "Points",
          "type": "integer"
        }
      },
      "required": [
        "duration_s",
        "points",
        "game",
        "mic"
      ],
      "title": "WaveformOut",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CronistaContracts"
}
